# ==============================================================================
# OpenFGA Studio — multi-environment configuration
# ==============================================================================
#
# The studio switches between environments from the UI. Each environment has:
#   - NON-SECRET values (VITE_* — inlined into the client bundle at build time)
#   - SECRET values (NON-VITE — read only by the proxy, NEVER shipped to the
#     browser). The dev (vite) and container (nginx) proxies inject the X2S as
#     the Basic auth header when forwarding /token-service/<env>.
#
# .env and .env.prod are gitignored. Do NOT commit real production values.
# ------------------------------------------------------------------------------

# Optional, env-agnostic manual token override (lowest priority; usually blank).
VITE_OPENFGA_API_TOKEN=

# --- NPE-XUS (non-prod, default) ---
VITE_OPENFGA_API_URL_NPE_XUS=https://openfga-mx.npe.moodys.cloud
VITE_OPENFGA_STORE_ID_NPE_XUS=
VITE_TOKEN_SERVICE_AUDIENCE_NPE_XUS=openfga-mx
# Secret — server-side only (never VITE_):
TOKEN_SERVICE_URL_NPE_XUS=
FGA_X2S_TOKEN_NPE_XUS=

# --- Canary (Can-US) ---
VITE_OPENFGA_API_URL_CAN_US=
VITE_OPENFGA_STORE_ID_CAN_US=
VITE_TOKEN_SERVICE_AUDIENCE_CAN_US=
TOKEN_SERVICE_URL_CAN_US=
FGA_X2S_TOKEN_CAN_US=

# --- Production XUS ---
VITE_OPENFGA_API_URL_XUS=
VITE_OPENFGA_STORE_ID_XUS=
VITE_TOKEN_SERVICE_AUDIENCE_XUS=
TOKEN_SERVICE_URL_XUS=
FGA_X2S_TOKEN_XUS=

# --- Production XEU ---
VITE_OPENFGA_API_URL_XEU=
VITE_OPENFGA_STORE_ID_XEU=
VITE_TOKEN_SERVICE_AUDIENCE_XEU=
TOKEN_SERVICE_URL_XEU=
FGA_X2S_TOKEN_XEU=
